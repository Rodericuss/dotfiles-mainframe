#!/usr/bin/env python3
"""Tailnet widget: shows the active Tailscale account; --toggle switches empresa <-> casa.

The two tailnet names live outside the repository, in ~/.config/mainframe/tailnet.json:
  {"empresa": "<tailnet da empresa>", "casa": "<tailnet de casa>"}
Without that file the widget only shows the current tailnet and the toggle is disabled."""
import json,subprocess,sys
from pathlib import Path
try:ACCOUNTS=json.loads((Path.home()/'.config/mainframe/tailnet.json').read_text())
except (OSError,ValueError):ACCOUNTS={}
EMPRESA=ACCOUNTS.get('empresa')
CASA=ACCOUNTS.get('casa')
NAMES={k:v for k,v in ((EMPRESA,'EMPRESA'),(CASA,'CASA')) if k}

def run(*a,timeout=3):
 return subprocess.run(['tailscale',*a],capture_output=True,text=True,timeout=timeout)

def current():
 # status works without operator rights; switch --list does not on profiles lacking --operator
 try:return (json.loads(run('status','--json').stdout or '{}').get('CurrentTailnet') or {}).get('Name')
 except ValueError:return None

def notify(msg,urgency='normal'):
 subprocess.run(['notify-send','-u',urgency,'-a','Tailnet','VPN',msg],stderr=subprocess.DEVNULL)

try:
 cur=current()
 if len(sys.argv)>1 and sys.argv[1]=='--toggle':
  if not (EMPRESA and CASA):
   notify('Defina "empresa" e "casa" em ~/.config/mainframe/tailnet.json','critical');sys.exit(0)
  target=CASA if cur==EMPRESA else EMPRESA
  r=run('switch',target,timeout=20)
  if r.returncode==0:notify(f'Tailnet → {NAMES[target]}')
  else:
   err=(r.stderr or r.stdout).strip()
   if 'access denied' in err.lower():err+='\nrode uma vez neste perfil: sudo tailscale set --operator=$USER'
   notify(f'Falha ao trocar para {NAMES[target]}: {err}','critical')
  subprocess.run(['pkill','-RTMIN+9','waybar'])
  sys.exit(0)
 status=json.loads(run('status','--json').stdout or '{}')
 state=status.get('BackendState','')
 if state!='Running':
  print(json.dumps({'text':'VPN —','class':'down','tooltip':f'Tailscale: {state or "indisponível"}'}));sys.exit(0)
 name=NAMES.get(cur,cur or '?')
 color='#5BA89B' if cur==EMPRESA else '#C8743F'
 other='CASA' if cur==EMPRESA else 'EMPRESA'
 print(json.dumps({'text':f'VPN <span foreground="{color}">{name}</span>','class':name.lower(),
  'tooltip':f'Tailnet ativa: {(status.get("CurrentTailnet") or {}).get("Name",cur)}\nclique para trocar para {other}'}))
except (OSError,ValueError,subprocess.SubprocessError):
 print(json.dumps({'text':'VPN —','class':'unavailable'}))
