{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "overlay",
  "control-center-margin-top": 0,
  "control-center-margin-bottom": 24,
  "control-center-margin-right": 16,
  "control-center-width": 360,
  "control-center-height": 480,
  "notification-window-width": 380,
  "timeout": 8,
  "timeout-low": 5,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "keyboard-shortcuts": true,
  "image-visibility": "never",
  "relative-timestamps": true,
  "notification-grouping": false,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "Nenhum aviso por aqui.",
  "widgets": [
    "title",
    "buttons-grid",
    "volume",
    "backlight",
    "dnd",
    "label#hoje",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "CENTRAL DE AVISOS",
      "clear-all-button": true,
      "button-text": "LIMPAR"
    },
    "dnd": {
      "text": "NÃO PERTURBE"
    },
    "volume": {
      "label": "VOL",
      "show-per-app": false
    },
    "backlight": {
      "label": "BRI",
      "device": "intel_backlight"
    },
    "label#hoje": {
      "text": "HOJE",
      "max-lines": 1
    },
    "buttons-grid": {
      "buttons-per-row": 4,
      "actions": [
        {
          "label": "WI-FI",
          "command": "~/.config/mainframe/scripts/radio wifi",
          "type": "toggle",
          "update-command": "~/.config/mainframe/scripts/radio wifi status"
        },
        {
          "label": "BT",
          "command": "~/.config/mainframe/scripts/radio bt",
          "type": "toggle",
          "update-command": "~/.config/mainframe/scripts/radio bt status"
        },
        {
          "label": "FOCO",
          "command": "~/.config/mainframe/control focus",
          "type": "toggle",
          "update-command": "~/.config/mainframe/control focus-status"
        },
        {
          "label": "MUDO",
          "command": "~/.config/mainframe/control volume --toggle",
          "type": "toggle",
          "update-command": "pamixer --get-mute"
        }
      ]
    }
  },
  "transition-time": 150
}