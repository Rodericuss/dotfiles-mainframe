#!/bin/sh
# Textos vivos da tela de bloqueio (chamados pelo hyprlock.conf).
case "$1" in
 date)  d=$(LC_ALL=pt_BR.UTF-8 date +'%A · %d DE %B' | LC_ALL=pt_BR.UTF-8 sed 's/.*/\U&/')
        printf '<span letter_spacing="4494">%s</span>\n' "$d" ;;  # 0.45em de 13px
 since) date +'desde %H:%M' ;;
 bat)   c=$(cat /sys/class/power_supply/BAT0/capacity 2>/dev/null || echo '--')
        printf 'BAT <span foreground="#9EEA8E">%s%%</span>\n' "$c" ;;
esac
